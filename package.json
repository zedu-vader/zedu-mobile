{
  "name": "zedu",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 react-native run-ios",
    "lint": "eslint src App.tsx index.js",
    "lint:fix": "eslint src App.tsx index.js --fix",
    "prepare": "husky",
    "postinstall": "patch-package && node -e \"if (process.platform !== 'win32') { try { require('child_process').execSync('chmod +x .husky/*', { stdio: 'inherit' }); } catch (e) {} }\"",
    "pre-commit": "lint-staged --concurrent false",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,md}\" App.tsx index.js babel.config.js metro.config.js jest.config.js commitlint.config.cjs .eslintrc.js .prettierrc.js",
    "check-lint": "eslint src App.tsx index.js",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,md}\" App.tsx index.js babel.config.js metro.config.js jest.config.js commitlint.config.cjs .eslintrc.js .prettierrc.js",
    "commitlint": "commitlint",
    "commitlint:check": "commitlint --from origin/main --to HEAD --verbose",
    "pr-review:check": "node .github/scripts/pr-review/run.mjs --base origin/main --head HEAD --config .github/pr-review.config.json --output review-report.json",
    "security:audit": "npm audit --audit-level high",
    "security:files": "bash .github/scripts/verify-changed-files.sh origin/main HEAD",
    "security:malware": "node .github/scripts/scan-malware.mjs",
    "start": "node init && react-native start --reset-cache",
    "test": "jest"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/slider": "^5.1.1",
    "@react-native-documents/picker": "^11.0.3",
    "@react-native-documents/viewer": "^3.0.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/drawer": "^7.8.1",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@sayem314/react-native-keep-awake": "^1.4.0",
    "axios": "^1.13.2",
    "centrifuge": "^5.5.3",
    "emoji-mart-native": "^0.6.5-beta",
    "moment": "^2.30.1",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-agora": "^4.6.2",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-bootsplash": "^6.3.11",
    "react-native-compressor": "^1.19.4",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-image-picker": "7.1.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-onesignal": "^5.2.16",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.25.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.18.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.7.1",
    "rn-emoji-keyboard": "^1.7.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "jscpd": "^4.0.5",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
